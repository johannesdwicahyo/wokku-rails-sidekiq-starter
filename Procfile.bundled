# foreman reads this file. It runs BOTH processes inside the same
# container, side-by-side. A crash in one restarts the whole container —
# an acceptable tradeoff for the slot saving.
#
# To split them into separate processes (2 slots, full isolation), move
# these entries to Procfile and remove the `bundle exec foreman` line.
rails:   bundle exec rails server -p $PORT
sidekiq: bundle exec sidekiq
